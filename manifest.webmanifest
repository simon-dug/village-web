{
  "name": "L'île",
  "short_name": "L'île",
  "description": "Vue d'ensemble des dossiers et capture rapide",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#dcecef",
  "theme_color": "#4fcbd2",
  "icons": [
    { "src": "icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Capturer", "short_name": "Capturer", "url": "./?capture=1", "icons": [{ "src": "icone-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "titre", "text": "texte", "url": "url", "files": [{ "name": "fichiers", "accept": ["image/*"] }] }
  }
}
